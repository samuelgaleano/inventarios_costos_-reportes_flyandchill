# ───────────────────────────────────────────────────────────────
#  Fly & Chill — variables de entorno
#  Copia este archivo a .env.local y completa los valores.
# ───────────────────────────────────────────────────────────────

# ── Supabase (datos + autenticación) ──────────────────────────
# Panel Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
# Clave maestra: SOLO en el servidor, nunca exponer al navegador
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# ── Resend (envío de informes por correo) ─────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_...
# Remitente verificado en Resend (dominio o correo)
REPORT_FROM_EMAIL=informes@tudominio.com
# Destinatario del informe general (administrador)
REPORT_ADMIN_EMAIL=admin@tudominio.com

# ── Google Sheets (respaldo externo de datos) — opcional ──────
# Cuenta de servicio de Google Cloud (JSON en una sola línea, o base64)
GOOGLE_SERVICE_ACCOUNT_EMAIL=svc@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID de la hoja de cálculo de respaldo (de la URL de Google Sheets)
GOOGLE_SHEET_ID=

# ── Seguridad de tareas programadas (Vercel Cron) ─────────────
# Cadena secreta para autorizar /api/cron/*
CRON_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Fly & Chill"
# Moneda (ISO 4217) y locale para formato
NEXT_PUBLIC_CURRENCY=COP
NEXT_PUBLIC_LOCALE=es-CO
